{
  "name": "anywork-library-plugin",
  "version": "0.2.14",
  "private": false,
  "description": "资料库：文件 + 笔记（DSH Web 插件）",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/store.js",
    "lib/update.js",
    "lib/client.js",
    "lib/api.js",
    "lib/panel.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "assemble": "node scripts/assemble.mjs",
    "test": "node scripts/assemble.mjs --check && node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokenAI-Beta/library-plugin.git"
  }
}
